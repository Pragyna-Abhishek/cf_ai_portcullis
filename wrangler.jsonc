{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portcullis",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  // The Workflow's originating path is keyed by constructor.name, so class names
  // must survive bundling. See DESIGN.md section 8 and CLAUDE.md invariant 11.
  "keep_names": true,
  "minify": false,
  "rules": [{ "type": "Text", "globs": ["prompts/*.txt"], "fallthrough": true }],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "IncidentAgent", "class_name": "IncidentAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["IncidentAgent"] }],
  "workflows": [
    {
      "name": "portcullis-investigation",
      "binding": "INVESTIGATION_WORKFLOW",
      "class_name": "InvestigationWorkflow"
    }
  ],
  "ai": { "binding": "AI" },
  "vars": {
    // "workers-ai" in production. Tests override this to "fake".
    "MODEL_MODE": "workers-ai",
    "MODEL_ID": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
  },
  // Required by `wrangler preview` (used by the Cloudflare Workers Builds PR-preview deploy
  // step; `wrangler deploy` for the real environment does not need this block). MODEL_MODE is
  // "fake" here, not "workers-ai": every PR push would otherwise trigger a preview deploy that
  // spends this account's daily Workers AI neuron allocation for no reviewer benefit, and could
  // starve a real investigation on the deployed site of that same day's quota.
  "previews": {
    "vars": {
      "MODEL_MODE": "fake",
      "MODEL_ID": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
    },
    "ai": { "binding": "AI" }
  },
  "observability": { "enabled": true }
}
